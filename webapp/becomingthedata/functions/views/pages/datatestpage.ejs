<!DOCTYPE html>
<html>
    <head>
        <title>GT Dataseum</title>
        <%- include('../includes/head'); %>

        <link rel="stylesheet" type="text/css" media="screen" href="/css/data.css">
        <script src="/js/firebase.js"></script>

    </head>

    <body>
        <div class="logo">
            <img src="/img/transparent_logo.svg" alt="Logo">
        </div>
        <div id="content" class="center" style="margin-top: 50px;">
            <div style="margin-top: 50px;"><%- include('../includes/dataseumtitle'); %></div>
            <hr>
            <h1>Visitor Data</h1>
            <table style="">
                <thead>
                    <tr>
                        <th>SessionID</th>
                        <th>Group</th>
                        <th>Active</th>
                        <th>Start Time</th>
                        <th>ExhibitInfo</th>
                    </tr>
                </thead>
                <tbody>
                    <% visitors.forEach(visitor => { %>
                        <tr>
                            <td><%= visitor.sessionId %></td>
                            <td><%= visitor.group %></td>
                            <td><%= visitor.active %></td>
                            <td><%= visitor.starttime.toDate().toLocaleString() %></td>
                            <td style="overflow-x: scroll;">
                                AC: completed=<%= visitor.exhibitinfo.acid.completed %>|<%= visitor.exhibitinfo.acid.errors %> errors,
                                AQI: <%= visitor.exhibitinfo.airquality.personalaqilimit%> | quiz: <%= visitor.exhibitinfo.airquality.correct %>, 
                                map: [<%= visitor.exhibitinfo.datamap.q1 %> | <%= visitor.exhibitinfo.datamap.q2 %> | <%= visitor.exhibitinfo.datamap.q3 %>],
                                game: [$<%= visitor.exhibitinfo.gridgame.priceincrease %> | <%= visitor.exhibitinfo.gridgame.reliability %>], 
                                fish: [<%= visitor.exhibitinfo.oceans.name %>], 
                                social: <%= visitor.exhibitinfo.socialdata %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <script>
            async function displayVisitors() {
                const response = await fetch('/data');
                const data = await response.json();
                console.log(data); // Log the visitor data to console
            }
            displayVisitors();
        </script>
    </body>
</html>